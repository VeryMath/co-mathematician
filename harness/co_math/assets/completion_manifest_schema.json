{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Co-Mathematician Completion Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "workstream_id",
    "goal_id",
    "author_run_id",
    "completed_at",
    "goal_approval",
    "report",
    "reviews",
    "checked_artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "workstream_id": {
      "type": "string",
      "minLength": 1
    },
    "goal_id": {
      "type": "string",
      "minLength": 1
    },
    "author_run_id": {
      "type": "string",
      "minLength": 1
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "goal_approval": {
      "type": "object",
      "required": ["approval_id", "approved_by", "approved_at"],
      "properties": {
        "approval_id": {"type": "string", "minLength": 1},
        "approved_by": {"type": "string", "minLength": 1},
        "approved_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "report": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^reviewed/report-[0-9a-f]{64}\\.md$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "reviews": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^reviews/[A-Za-z0-9][A-Za-z0-9_.-]{0,127}\\.json$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "checked_artifacts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
